# Copy to .env and fill in ONE of the keys. Never commit .env.
GOOGLE_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# Optional tuning
# GEMINI_MODEL=gemini-3.6-flash
# EMBEDDING_BACKEND=auto      # auto | hf | tfidf
# SENTIMENT_BACKEND=auto      # auto | hf | lexicon   (use lexicon on low-memory hosts)
